# Copie para .env e ajuste.

# Segredo usado para assinar logins e criptografar os tokens salvos (mínimo 16 caracteres).
# Gere com: openssl rand -hex 32   — NÃO troque depois de configurar, ou os tokens salvos se perdem.
APP_SECRET=

# Senha do banco (docker-compose)
DB_PASSWORD=troque-esta-senha

# Primeiro acesso (o administrador é criado só quando o banco está vazio)
ADMIN_EMAIL=admin@seuprovedor.com.br
# Se ficar vazio, uma senha aleatória é gerada e mostrada uma única vez no log (docker compose logs app)
ADMIN_PASSWORD=troque-esta-senha

# Porta exposta no servidor
PORT=3000

# Só para rodar fora do Docker:
# DATABASE_URL=postgresql://sendtec:sendtec@localhost:5432/sendtec
